# App
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
NEXT_PUBLIC_SHOW_DEBUG=false

# Optional Supabase online publishing
NEXT_PUBLIC_SUPABASE_URL=
# Preferred current client-side key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=mockup-assets
# Localhost server only (sb_secret_...). Never add this to Netlify.
SUPABASE_SECRET_KEY=

# Local Studio (uses the existing Next.js localhost process, not a separate server)
CHILI_LOCAL_STUDIO_ENABLED=true
# Defaults to .chili-local-library inside the project when blank.
CHILI_LOCAL_LIBRARY_PATH=
MAX_UPLOAD_SIZE_MB=50
MAX_PRODUCT_PACKAGE_SIZE_MB=512

# Optional features for later
ENABLE_MASK_QA=false
